# --- RPC Solana ---
# Ne PAS utiliser le RPC public en prod (trop lent / rate-limité pour du sniping).
# Exemples : Helius, QuickNode, Triton
RPC_URL=https://mainnet.helius-rpc.com/?api-key=TON_API_KEY_ICI
WSS_URL=wss://mainnet.helius-rpc.com/?api-key=TON_API_KEY_ICI

# --- APIs externes ---
BIRDEYE_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# --- Wallet (JAMAIS commité, JAMAIS partagé) ---
# Clé privée encodée en base58, format Phantom/Solflare export
WALLET_PRIVATE_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Seuils anti-rug ---
MIN_LIQUIDITY_USD=3000
MAX_TOP_HOLDER_PCT=15.0
MIN_SCORE_TO_BUY=75

# --- Sécurité ---
# false par défaut : le bot alerte seulement, tu achètes manuellement via /buy
# true : achat automatique dès qu'un token passe le seuil anti-rug (RISQUÉ)
AUTO_BUY=false

# --- Paramètres de trading ---
BUY_AMOUNT_SOL=0.05
SLIPPAGE_BPS=2000
COMPUTE_UNIT_PRICE=100000
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
